<?xml version="1.0" encoding="utf-8"?>
<kr-script>
    <text title="这是一个 Miuix 重写示例">
        <summary>由 PageConfigReader 解析 XML 生成</summary>
        <slice bold="true" size="16">第一行：加粗文本</slice>
        <slice italic="true">第二行：斜体文本</slice>
    </text>

    <group title="常用工具">
        <switch title="示例开关" summary="SwitchPreference">
            <get>echo 1</get>
            <set>echo $state</set>
        </switch>

        <picker title="示例选择器" summary="OverlayDropdownPreference">
            <option val="a">选项 A</option>
            <option val="b">选项 B</option>
        </picker>
    </group>

    <action title="执行动作" summary="ArrowPreference">
        <script>echo ok</script>
    </action>

    <action title="带参数动作" summary="会弹出参数表单">
        <param name="msg" title="消息" value="hello" />
        <param name="count" title="次数" type="seekbar" min="1" max="10" value="3" />
        <param name="mode" title="模式" type="select">
            <option val="fast">快速</option>
            <option val="safe">安全</option>
        </param>
        <param name="enable" title="启用" type="switch" value="1" />
        <param name="color" title="颜色" type="color" value="#FF0000" />
        <param name="file" title="文件" type="file" />
        <param name="tags" title="多选" type="multiple" separator=",">
            <option val="a">标签 A</option>
            <option val="b">标签 B</option>
            <option val="c">标签 C</option>
        </param>
        <script>echo "$msg $count $mode $enable $color $file $tags"</script>
    </action>

    <page title="子页面" summary="进入下一个页面">
        <config>file:///android_asset/sample.xml</config>
    </page>

    <page title="在线页面" summary="WebView 加载">
        <html>https://example.com</html>
    </page>

    <page title="带菜单页面" summary="页面菜单示例">
        <option>刷新</option>
        <option>关于</option>
        <config>file:///android_asset/sample.xml</config>
    </page>
</kr-script>
